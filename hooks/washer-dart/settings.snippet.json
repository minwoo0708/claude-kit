{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "dart \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_dart.dart\"",
            "timeout": 60,
            "statusMessage": "dart format"
          },
          {
            "type": "command",
            "command": "dart \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_dart_conventions.dart\"",
            "timeout": 60,
            "statusMessage": "아키텍처·파일명·중복 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_module_readme.dart\"",
            "timeout": 60,
            "statusMessage": "모듈 README 갱신 확인"
          }
        ]
      }
    ]
  }
}